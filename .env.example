DATABASE_URL="postgresql://user:password@host:5432/an_logistics?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# 32-byte base64 key used for AES-256-GCM encryption of CourierApiConfig.apiKeyEncrypted.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"

# AN-accounting connection (see src/lib/accounting-sync.ts). PAID platform-fee
# Invoices are pushed to AN-accounting's /api/external/sales as they're
# marked paid. ACCOUNTING_API_KEY is the Bearer key issued from
# AN-accounting's Settings -> Sales API for the "AN Logistics" division.
ACCOUNTING_API_URL="https://your-an-accounting-deployment.example.com"
ACCOUNTING_API_KEY="ansk_..."
