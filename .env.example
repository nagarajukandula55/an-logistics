DATABASE_URL="postgresql://user:password@host:5432/an_logistics?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# 32-byte base64 key used for AES-256-GCM encryption of CourierApiConfig.apiKeyEncrypted.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"

# AN-accounting connection (see src/lib/accounting-sync.ts). PAID platform-fee
# Invoices are pushed to AN-accounting's /api/external/sales as they're
# marked paid. ACCOUNTING_API_KEY is the Bearer key issued from
# AN-accounting's Settings -> Sales API for the "AN Logistics" division.
ACCOUNTING_API_URL="https://your-an-accounting-deployment.example.com"
ACCOUNTING_API_KEY="ansk_..."

# ANyPay wallet, exposed by AN-accounting (see src/lib/wallet.ts). Used to
# push/confirm WalletTransaction entries against the central ledger when a
# Customer's balance moves here. If unset, the wallet still works locally
# (balance + WalletTransaction rows) but nothing syncs to ANyPay.
WALLET_API_URL="https://your-an-accounting-deployment.example.com"
WALLET_API_KEY="anwk_..."

# Zoho Sign — e-sign for B2B/B2C Agreements (see src/lib/agreements.ts).
# Free plan: 5 envelopes/month, single user — fine for low agreement volume.
# Register a "Self Client" at https://api-console.zoho.in (India DC), scope
# ZohoSign.documents.ALL, generate a grant token, then exchange it once for
# a refresh token via /oauth/v2/token?grant_type=authorization_code — that
# refresh token goes here and is reused indefinitely.
ZOHO_SIGN_CLIENT_ID="1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
ZOHO_SIGN_CLIENT_SECRET="..."
ZOHO_SIGN_REFRESH_TOKEN="1000...."
# Domains default to the India DC (.in) below if unset; change to .com/.eu/
# etc. if the Zoho account lives in a different data center.
ZOHO_SIGN_API_DOMAIN="sign.zoho.in"
ZOHO_SIGN_ACCOUNTS_DOMAIN="accounts.zoho.in"
# Checked against the ?secret= query param on the completion webhook —
# set this in Zoho Sign's Settings -> Integrations -> Webhooks notify URL:
#   https://your-deployment.example.com/api/webhooks/zoho-sign?secret=<this>
ZOHO_SIGN_WEBHOOK_SECRET="generate-a-random-string"

# Telegram bot (BotFather). Per-Customer chat linking happens via the
# /start deep link in src/app/api/telegram/webhook/route.ts — set this
# webhook with Telegram once deployed:
#   https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/setWebhook?url=<your-deployment>/api/telegram/webhook&secret_token=<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN="123456:ABC-..."
TELEGRAM_BOT_USERNAME="an_logistics_bot"
TELEGRAM_WEBHOOK_SECRET="generate-a-random-string"

# Authenticates calls to /api/cron/sync-tracking (see route.ts). If unset,
# the endpoint accepts unauthenticated requests — set this before go-live.
CRON_SECRET="generate-a-random-string"
