generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Tenancy ----------
// A Tenant is "whose orders/users/billing these are" — distinct from
// CourierPartner ("a fulfillment option we can route to"). A business that
// is both a client (brings us their own order volume) and a fulfillment
// partner (their network can be routed to) gets one row of each, joined by
// CourierPartner.tenantId. INTERNAL is our own business; MARKETPLACE is the
// singleton bucket public aggregator bookings roll up to; CLIENT is anyone
// else (a business we run, or a company like a courier that becomes a
// direct client) whose volume we operate through this platform.

enum TenantType {
  INTERNAL
  CLIENT
  MARKETPLACE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ONBOARDING
}

model Tenant {
  id                     String          @id @default(cuid())
  slug                   String          @unique
  name                   String
  type                   TenantType
  status                 TenantStatus    @default(ONBOARDING)
  billingEmail           String?
  billingAddress         String?
  gstin                  String?
  defaultCommissionType  CommissionType?
  defaultCommissionValue Float?
  webhookUrl             String?
  webhookSecret          String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  users          User[]
  orders         Order[]
  vehicles       Vehicle[]
  drivers        Driver[]
  warehouses     Warehouse[]
  customers      Customer[]
  courierPartner CourierPartner?
  apiKeys        TenantApiKey[]
  invoices       Invoice[]       @relation("InvoiceForTenant")
  settlements    Settlement[]    @relation("SettlementForTenant")

  @@index([type])
  @@index([status])
}

model TenantApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  label      String
  keyPrefix  String    @unique
  keyHash    String
  scopes     String[]
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@index([keyPrefix])
}

// ---------- Access control ----------

enum UserRole {
  ADMIN
  DISPATCHER
  DRIVER
  WAREHOUSE
  CUSTOMER
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          UserRole  @default(DISPATCHER)
  isActive      Boolean   @default(true)
  mustChangePassword Boolean @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  tenantId      String?

  driverProfile Driver?
  customer      Customer? @relation(fields: [customerId], references: [id])
  customerId    String?

  @@index([customerId])
  @@index([tenantId])
}

// ---------- Customers ----------
// Modeled as a first-class tenant from day one so the same schema
// supports internal-only usage now and self-service customers later.

model Customer {
  id          String   @id @default(cuid())
  name        String
  billingName String?
  phone       String?
  email       String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  tenantId    String?

  users    User[]
  orders   Order[]

  @@index([name])
  @@index([tenantId])
}

// ---------- Fleet ----------

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  MAINTENANCE
  INACTIVE
}

model Vehicle {
  id           String        @id @default(cuid())
  registration String        @unique
  type         String
  capacityKg   Float?
  status       VehicleStatus @default(AVAILABLE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant       Tenant?       @relation(fields: [tenantId], references: [id])
  tenantId     String?

  drivers Driver[]
  orders  Order[]

  @@index([tenantId])
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
}

model Driver {
  id           String       @id @default(cuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id])
  phone        String
  licenseNo    String
  status       DriverStatus @default(AVAILABLE)
  vehicleId    String?
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant       Tenant?      @relation(fields: [tenantId], references: [id])
  tenantId     String?

  orders Order[]

  @@index([vehicleId])
  @@index([tenantId])
}

// ---------- Locations ----------

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  address   String
  city      String
  createdAt DateTime @default(now())

  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  tenantId  String?

  originOrders      Order[] @relation("OriginWarehouse")
  destinationOrders Order[] @relation("DestinationWarehouse")

  @@index([tenantId])
}

// ---------- Orders / shipments ----------

enum OrderStatus {
  CREATED
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}

enum OrderFulfillmentType {
  SELF_FLEET
  COURIER_PARTNER
}

enum OrderAssignmentMethod {
  MANUAL
  AUTO
}

model Order {
  id                    String      @id @default(cuid())
  trackingCode          String      @unique
  tenantId              String?
  tenant                Tenant?     @relation(fields: [tenantId], references: [id])
  customerId            String
  customer              Customer    @relation(fields: [customerId], references: [id])

  pickupAddress         String
  pickupContactName     String
  pickupContactPhone    String
  pickupPincode         String?
  originWarehouseId     String?
  originWarehouse       Warehouse?  @relation("OriginWarehouse", fields: [originWarehouseId], references: [id])

  deliveryAddress       String
  deliveryContactName   String
  deliveryContactPhone  String
  deliveryPincode       String?
  destinationWarehouseId String?
  destinationWarehouse  Warehouse?  @relation("DestinationWarehouse", fields: [destinationWarehouseId], references: [id])

  weightKg              Float?
  packageDescription    String?
  codAmount             Float?

  status                OrderStatus @default(CREATED)

  driverId              String?
  driver                Driver?     @relation(fields: [driverId], references: [id])
  vehicleId             String?
  vehicle               Vehicle?    @relation(fields: [vehicleId], references: [id])

  fulfillmentType       OrderFulfillmentType   @default(SELF_FLEET)
  assignmentMethod      OrderAssignmentMethod  @default(MANUAL)
  courierPartnerId      String?
  courierPartner        CourierPartner? @relation(fields: [courierPartnerId], references: [id])
  courierBranchId       String?
  courierBranch         CourierBranch?  @relation(fields: [courierBranchId], references: [id])
  platformFeeAmount     Float?
  courierPayoutAmount   Float?
  providerRef           String?
  providerLabelUrl      String?
  chargedAmount         Float?
  // Which specific option within the assigned provider was picked at
  // dispatch time (e.g. one of Shiprocket's several bundled couriers) —
  // set by assignOrderToCourierAction, read by provider.createShipment
  // when the shipment is actually booked.
  selectedProviderCourierId String?

  createdAt             DateTime    @default(now())
  updatedAt              DateTime   @updatedAt

  statusEvents          OrderStatusEvent[]
  proofOfDelivery        ProofOfDelivery?
  invoiceLineItems       InvoiceLineItem[]
  settlementLineItems    SettlementLineItem[]

  @@index([customerId])
  @@index([driverId])
  @@index([status])
  @@index([deliveryPincode])
  @@index([courierPartnerId])
  @@index([tenantId])
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model ProofOfDelivery {
  id           String   @id @default(cuid())
  orderId      String   @unique
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  signedByName String
  photoUrl     String?
  notes        String?
  createdAt    DateTime @default(now())
}

// ---------- Courier aggregator marketplace ----------
// Courier partners onboard onto the platform and fulfill orders alongside
// (not instead of) the self-fleet model above. Manual/WhatsApp coordination
// today; real per-courier API integration is a planned next phase.

enum CourierPartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum CourierIntegrationType {
  MANUAL
  API
}

enum CommissionType {
  PERCENT
  FLAT
}

enum CourierAgreementStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

model CourierPartner {
  id              String                  @id @default(cuid())
  name            String
  legalName       String?
  contactName     String
  contactPhone    String
  contactEmail    String?
  status          CourierPartnerStatus    @default(PENDING)
  integrationType CourierIntegrationType  @default(MANUAL)
  commissionType  CommissionType          @default(PERCENT)
  commissionValue Float
  // Routing precedence when multiple partners (including our own self-fleet,
  // which is registered as a partner row too) service a pincode — higher
  // goes first. Lets "check our own network, then fall back to a ranked
  // local partner" be an explicit admin setting rather than alphabetical.
  priority        Int                     @default(0)
  notes           String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  // Nullable: most partners are pure fulfillment options with no tenant
  // login/billing identity of their own. Set only when a partner is also
  // onboarded as a client/business we operate (see Tenant doc comment).
  tenant          Tenant?                 @relation(fields: [tenantId], references: [id])
  tenantId        String?                 @unique

  branches        CourierBranch[]
  agreements      CourierAgreement[]
  apiConfig       CourierApiConfig?
  orders          Order[]
  rateCards       RateCard[]
  settlements     Settlement[]

  @@index([status])
}

model CourierBranch {
  id               String         @id @default(cuid())
  courierPartnerId String
  courierPartner   CourierPartner @relation(fields: [courierPartnerId], references: [id])
  name             String
  address          String
  city             String
  contactPhone     String
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  serviceAreas     ServiceArea[]
  orders           Order[]

  @@index([courierPartnerId])
}

model ServiceArea {
  id              String        @id @default(cuid())
  courierBranchId String
  courierBranch   CourierBranch @relation(fields: [courierBranchId], references: [id])
  pincode         String
  city            String?
  createdAt       DateTime      @default(now())

  @@index([pincode])
  @@index([courierBranchId])
}

model CourierAgreement {
  id                String                  @id @default(cuid())
  courierPartnerId  String
  courierPartner    CourierPartner          @relation(fields: [courierPartnerId], references: [id])
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  commissionType    CommissionType
  commissionValue   Float
  documentUrl       String?
  status            CourierAgreementStatus  @default(DRAFT)
  createdAt         DateTime                @default(now())

  @@index([courierPartnerId])
}

// ---------- Rate cards ----------
// A courier partner's priced offering: a named, versioned card of
// weight/zone-banded slabs. Only one card per partner is ACTIVE at a time —
// mirrors the CourierAgreement supersede-on-create pattern above.

model RateCard {
  id                String            @id @default(cuid())
  courierPartnerId  String
  courierPartner    CourierPartner    @relation(fields: [courierPartnerId], references: [id])
  name              String
  isActive          Boolean           @default(true)
  effectiveFrom     DateTime
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  slabs             RateCardSlab[]

  @@index([courierPartnerId])
}

model RateCardSlab {
  id           String   @id @default(cuid())
  rateCardId   String
  rateCard     RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)
  zone         String
  minWeightKg  Float
  maxWeightKg  Float
  price        Float
  isActive     Boolean  @default(true)

  @@index([rateCardId])
}

model CourierApiConfig {
  id                String         @id @default(cuid())
  courierPartnerId  String         @unique
  courierPartner    CourierPartner @relation(fields: [courierPartnerId], references: [id])
  provider          String
  baseUrl           String?
  // AES-256-GCM ciphertext (iv:authTag:ciphertext, base64), see src/lib/crypto.ts.
  // Encrypted on write in createOrUpdateApiConfigAction; requires ENCRYPTION_KEY.
  apiKeyEncrypted    String?
  webhookUrl        String?
  isActive          Boolean        @default(false)
}

// ---------- Billing ----------
// Two distinct money-flow directions: Invoice is us billing a CLIENT tenant
// for platform usage; Settlement is us reconciling payouts with a
// CourierPartner. A partner who is also a tenant can see their Settlements
// through their tenant portal view (Settlement.tenantId).

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

enum SettlementStatus {
  DRAFT
  FINALIZED
  PAID
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  tenantId      String
  tenant        Tenant        @relation("InvoiceForTenant", fields: [tenantId], references: [id])
  periodStart   DateTime
  periodEnd     DateTime
  status        InvoiceStatus @default(DRAFT)
  subtotal      Float
  taxAmount     Float         @default(0)
  totalAmount   Float
  issuedAt      DateTime?
  dueAt         DateTime?
  paidAt        DateTime?
  pdfUrl        String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lineItems     InvoiceLineItem[]

  @@index([tenantId])
  @@index([status])
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id])
  description String
  quantity    Float    @default(1)
  unitPrice   Float
  amount      Float

  @@index([invoiceId])
  @@index([orderId])
}

model Settlement {
  id                 String           @id @default(cuid())
  settlementNumber   String           @unique
  courierPartnerId   String
  courierPartner     CourierPartner   @relation(fields: [courierPartnerId], references: [id])
  tenantId           String?
  tenant             Tenant?          @relation("SettlementForTenant", fields: [tenantId], references: [id])
  periodStart        DateTime
  periodEnd          DateTime
  status             SettlementStatus @default(DRAFT)
  grossPayoutAmount  Float
  commissionDeducted Float
  netAmount          Float
  paidAt             DateTime?
  createdAt          DateTime         @default(now())

  lineItems          SettlementLineItem[]

  @@index([courierPartnerId])
  @@index([tenantId])
}

model SettlementLineItem {
  id               String     @id @default(cuid())
  settlementId     String
  settlement       Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  orderId          String
  order            Order      @relation(fields: [orderId], references: [id])
  payoutAmount     Float
  commissionAmount Float

  @@index([settlementId])
  @@index([orderId])
}
