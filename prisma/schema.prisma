generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Access control ----------

enum UserRole {
  ADMIN
  DISPATCHER
  DRIVER
  WAREHOUSE
  CUSTOMER
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          UserRole  @default(DISPATCHER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  driverProfile Driver?
  customer      Customer? @relation(fields: [customerId], references: [id])
  customerId    String?

  @@index([customerId])
}

// ---------- Customers ----------
// Modeled as a first-class tenant from day one so the same schema
// supports internal-only usage now and self-service customers later.

model Customer {
  id          String   @id @default(cuid())
  name        String
  billingName String?
  phone       String?
  email       String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users    User[]
  orders   Order[]

  @@index([name])
}

// ---------- Fleet ----------

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  MAINTENANCE
  INACTIVE
}

model Vehicle {
  id           String        @id @default(cuid())
  registration String        @unique
  type         String
  capacityKg   Float?
  status       VehicleStatus @default(AVAILABLE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  drivers Driver[]
  orders  Order[]
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
}

model Driver {
  id           String       @id @default(cuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id])
  phone        String
  licenseNo    String
  status       DriverStatus @default(AVAILABLE)
  vehicleId    String?
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  orders Order[]

  @@index([vehicleId])
}

// ---------- Locations ----------

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  address   String
  city      String
  createdAt DateTime @default(now())

  originOrders      Order[] @relation("OriginWarehouse")
  destinationOrders Order[] @relation("DestinationWarehouse")
}

// ---------- Orders / shipments ----------

enum OrderStatus {
  CREATED
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}

model Order {
  id                    String      @id @default(cuid())
  trackingCode          String      @unique
  customerId            String
  customer              Customer    @relation(fields: [customerId], references: [id])

  pickupAddress         String
  pickupContactName     String
  pickupContactPhone    String
  originWarehouseId     String?
  originWarehouse       Warehouse?  @relation("OriginWarehouse", fields: [originWarehouseId], references: [id])

  deliveryAddress       String
  deliveryContactName   String
  deliveryContactPhone  String
  destinationWarehouseId String?
  destinationWarehouse  Warehouse?  @relation("DestinationWarehouse", fields: [destinationWarehouseId], references: [id])

  weightKg              Float?
  packageDescription    String?
  codAmount             Float?

  status                OrderStatus @default(CREATED)

  driverId              String?
  driver                Driver?     @relation(fields: [driverId], references: [id])
  vehicleId             String?
  vehicle               Vehicle?    @relation(fields: [vehicleId], references: [id])

  createdAt             DateTime    @default(now())
  updatedAt              DateTime   @updatedAt

  statusEvents          OrderStatusEvent[]
  proofOfDelivery        ProofOfDelivery?

  @@index([customerId])
  @@index([driverId])
  @@index([status])
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model ProofOfDelivery {
  id           String   @id @default(cuid())
  orderId      String   @unique
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  signedByName String
  photoUrl     String?
  notes        String?
  createdAt    DateTime @default(now())
}
