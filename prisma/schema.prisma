generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Access control ----------

enum UserRole {
  ADMIN
  DISPATCHER
  DRIVER
  WAREHOUSE
  CUSTOMER
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          UserRole  @default(DISPATCHER)
  isActive      Boolean   @default(true)
  mustChangePassword Boolean @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  driverProfile Driver?
  customer      Customer? @relation(fields: [customerId], references: [id])
  customerId    String?

  @@index([customerId])
}

// ---------- Customers ----------
// Modeled as a first-class tenant from day one so the same schema
// supports internal-only usage now and self-service customers later.

model Customer {
  id          String   @id @default(cuid())
  name        String
  billingName String?
  phone       String?
  email       String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users    User[]
  orders   Order[]

  @@index([name])
}

// ---------- Fleet ----------

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  MAINTENANCE
  INACTIVE
}

model Vehicle {
  id           String        @id @default(cuid())
  registration String        @unique
  type         String
  capacityKg   Float?
  status       VehicleStatus @default(AVAILABLE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  drivers Driver[]
  orders  Order[]
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
}

model Driver {
  id           String       @id @default(cuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id])
  phone        String
  licenseNo    String
  status       DriverStatus @default(AVAILABLE)
  vehicleId    String?
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  orders Order[]

  @@index([vehicleId])
}

// ---------- Locations ----------

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  address   String
  city      String
  createdAt DateTime @default(now())

  originOrders      Order[] @relation("OriginWarehouse")
  destinationOrders Order[] @relation("DestinationWarehouse")
}

// ---------- Orders / shipments ----------

enum OrderStatus {
  CREATED
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}

enum OrderFulfillmentType {
  SELF_FLEET
  COURIER_PARTNER
}

enum OrderAssignmentMethod {
  MANUAL
  AUTO
}

model Order {
  id                    String      @id @default(cuid())
  trackingCode          String      @unique
  customerId            String
  customer              Customer    @relation(fields: [customerId], references: [id])

  pickupAddress         String
  pickupContactName     String
  pickupContactPhone    String
  pickupPincode         String?
  originWarehouseId     String?
  originWarehouse       Warehouse?  @relation("OriginWarehouse", fields: [originWarehouseId], references: [id])

  deliveryAddress       String
  deliveryContactName   String
  deliveryContactPhone  String
  deliveryPincode       String?
  destinationWarehouseId String?
  destinationWarehouse  Warehouse?  @relation("DestinationWarehouse", fields: [destinationWarehouseId], references: [id])

  weightKg              Float?
  packageDescription    String?
  codAmount             Float?

  status                OrderStatus @default(CREATED)

  driverId              String?
  driver                Driver?     @relation(fields: [driverId], references: [id])
  vehicleId             String?
  vehicle               Vehicle?    @relation(fields: [vehicleId], references: [id])

  fulfillmentType       OrderFulfillmentType   @default(SELF_FLEET)
  assignmentMethod      OrderAssignmentMethod  @default(MANUAL)
  courierPartnerId      String?
  courierPartner        CourierPartner? @relation(fields: [courierPartnerId], references: [id])
  courierBranchId       String?
  courierBranch         CourierBranch?  @relation(fields: [courierBranchId], references: [id])
  platformFeeAmount     Float?
  courierPayoutAmount   Float?

  createdAt             DateTime    @default(now())
  updatedAt              DateTime   @updatedAt

  statusEvents          OrderStatusEvent[]
  proofOfDelivery        ProofOfDelivery?

  @@index([customerId])
  @@index([driverId])
  @@index([status])
  @@index([deliveryPincode])
  @@index([courierPartnerId])
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model ProofOfDelivery {
  id           String   @id @default(cuid())
  orderId      String   @unique
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  signedByName String
  photoUrl     String?
  notes        String?
  createdAt    DateTime @default(now())
}

// ---------- Courier aggregator marketplace ----------
// Courier partners onboard onto the platform and fulfill orders alongside
// (not instead of) the self-fleet model above. Manual/WhatsApp coordination
// today; real per-courier API integration is a planned next phase.

enum CourierPartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum CourierIntegrationType {
  MANUAL
  API
}

enum CommissionType {
  PERCENT
  FLAT
}

enum CourierAgreementStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

model CourierPartner {
  id              String                  @id @default(cuid())
  name            String
  legalName       String?
  contactName     String
  contactPhone    String
  contactEmail    String?
  status          CourierPartnerStatus    @default(PENDING)
  integrationType CourierIntegrationType  @default(MANUAL)
  commissionType  CommissionType          @default(PERCENT)
  commissionValue Float
  notes           String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  branches        CourierBranch[]
  agreements      CourierAgreement[]
  apiConfig       CourierApiConfig?
  orders          Order[]
  rateCards       RateCard[]

  @@index([status])
}

model CourierBranch {
  id               String         @id @default(cuid())
  courierPartnerId String
  courierPartner   CourierPartner @relation(fields: [courierPartnerId], references: [id])
  name             String
  address          String
  city             String
  contactPhone     String
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  serviceAreas     ServiceArea[]
  orders           Order[]

  @@index([courierPartnerId])
}

model ServiceArea {
  id              String        @id @default(cuid())
  courierBranchId String
  courierBranch   CourierBranch @relation(fields: [courierBranchId], references: [id])
  pincode         String
  city            String?
  createdAt       DateTime      @default(now())

  @@index([pincode])
  @@index([courierBranchId])
}

model CourierAgreement {
  id                String                  @id @default(cuid())
  courierPartnerId  String
  courierPartner    CourierPartner          @relation(fields: [courierPartnerId], references: [id])
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  commissionType    CommissionType
  commissionValue   Float
  documentUrl       String?
  status            CourierAgreementStatus  @default(DRAFT)
  createdAt         DateTime                @default(now())

  @@index([courierPartnerId])
}

// ---------- Rate cards ----------
// A courier partner's priced offering: a named, versioned card of
// weight/zone-banded slabs. Only one card per partner is ACTIVE at a time —
// mirrors the CourierAgreement supersede-on-create pattern above.

model RateCard {
  id                String            @id @default(cuid())
  courierPartnerId  String
  courierPartner    CourierPartner    @relation(fields: [courierPartnerId], references: [id])
  name              String
  isActive          Boolean           @default(true)
  effectiveFrom     DateTime
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  slabs             RateCardSlab[]

  @@index([courierPartnerId])
}

model RateCardSlab {
  id           String   @id @default(cuid())
  rateCardId   String
  rateCard     RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)
  zone         String
  minWeightKg  Float
  maxWeightKg  Float
  price        Float
  isActive     Boolean  @default(true)

  @@index([rateCardId])
}

model CourierApiConfig {
  id                String         @id @default(cuid())
  courierPartnerId  String         @unique
  courierPartner    CourierPartner @relation(fields: [courierPartnerId], references: [id])
  provider          String
  baseUrl           String?
  // AES-256-GCM ciphertext (iv:authTag:ciphertext, base64), see src/lib/crypto.ts.
  // Encrypted on write in createOrUpdateApiConfigAction; requires ENCRYPTION_KEY.
  apiKeyEncrypted    String?
  webhookUrl        String?
  isActive          Boolean        @default(false)
}
