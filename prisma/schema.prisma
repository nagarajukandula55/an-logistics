generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Tenancy ----------
// A Tenant is "whose orders/users/billing these are" — distinct from
// CourierPartner ("a fulfillment option we can route to"). A business that
// is both a client (brings us their own order volume) and a fulfillment
// partner (their network can be routed to) gets one row of each, joined by
// CourierPartner.tenantId. INTERNAL is our own business; MARKETPLACE is the
// singleton bucket public aggregator bookings roll up to; CLIENT is anyone
// else (a business we run, or a company like a courier that becomes a
// direct client) whose volume we operate through this platform.

enum TenantType {
  INTERNAL
  CLIENT
  MARKETPLACE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ONBOARDING
}

model Tenant {
  id                     String          @id @default(cuid())
  slug                   String          @unique
  name                   String
  type                   TenantType
  status                 TenantStatus    @default(ONBOARDING)
  billingEmail           String?
  billingAddress         String?
  // State name/code as GST expects it (e.g. "Karnataka") — required to sync
  // this tenant's platform-fee Invoices to AN-accounting, which computes
  // IGST/CGST+SGST off the customer's state. Not inferred from
  // billingAddress since that's free-text.
  billingState           String?
  gstin                  String?
  defaultCommissionType  CommissionType?
  defaultCommissionValue Float?
  webhookUrl             String?
  webhookSecret          String?
  // Client's own ops Telegram group — opt-in (telegramEnabled), connected
  // via the same /start deep-link flow as a Customer's TelegramLink (see
  // buildTenantTelegramConnectLink in lib/telegram.ts), just scoped to the
  // whole tenant rather than one Customer. Gets the same status-change
  // stream as webhookUrl, plus /shipments and /documents bot commands
  // scoped to this tenant's orders once added to their group.
  telegramGroupChatId    String?
  telegramGroupTitle     String?
  telegramEnabled        Boolean         @default(false)
  // Default pickup point for this tenant's own shipments booked via
  // POST /api/v1/shipments (e.g. native/angroup's warehouse) -- exposed
  // read-only over GET /api/v1/tenant so the calling app never has to
  // duplicate these in its own env vars/config; edited here on the tenant
  // detail page instead.
  pickupAddress          String?
  pickupPincode          String?
  pickupContactName      String?
  pickupContactPhone     String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  users          User[]
  orders         Order[]
  vehicles       Vehicle[]
  drivers        Driver[]
  warehouses     Warehouse[]
  customers      Customer[]
  courierPartner CourierPartner?
  apiKeys        TenantApiKey[]
  invoices       Invoice[]       @relation("InvoiceForTenant")
  settlements    Settlement[]    @relation("SettlementForTenant")
  sellRateCards  SellRateCard[]

  @@index([type])
  @@index([status])
  @@index([telegramGroupChatId])
}

model TenantApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  label      String
  keyPrefix  String    @unique
  keyHash    String
  scopes     String[]
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@index([keyPrefix])
}

// ---------- Access control ----------

enum UserRole {
  ADMIN
  DISPATCHER
  DRIVER
  WAREHOUSE
  CUSTOMER
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               UserRole @default(DISPATCHER)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  // The Customer owner (set on signup/first user of a Customer). Only the
  // owner can invite/deactivate staff Users under their Customer — see
  // inviteBusinessStaffAction / setStaffActiveAction.
  isBusinessOwner    Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  tenantId String?

  driverProfile Driver?
  customer      Customer? @relation(fields: [customerId], references: [id])
  customerId    String?

  @@index([customerId])
  @@index([tenantId])
}

// ---------- Customers ----------
// Modeled as a first-class tenant from day one so the same schema
// supports internal-only usage now and self-service customers later.

// INDIVIDUAL is a single shipper (self-service signup or staff-entered).
// BUSINESS can additionally invite staff Users under it (capped at
// maxStaffUsers, enforced in code — see inviteBusinessStaffAction) who all
// book against the business's own SellRateCard rather than one each.
enum CustomerKind {
  INDIVIDUAL
  BUSINESS
}

model Customer {
  onboardingApplication PartnerApplication?
  allowedCouriers       CustomerCourier[]
  id                    String              @id @default(cuid())
  name                  String
  billingName           String?
  phone                 String?
  email                 String?
  address               String?
  isActive              Boolean             @default(true)
  kind                  CustomerKind        @default(INDIVIDUAL)
  // Staff seats beyond the owner, BUSINESS only. Enforced in
  // inviteBusinessStaffAction, not a DB constraint.
  maxStaffUsers         Int                 @default(2)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  tenantId String?

  users         User[]
  orders        Order[]
  sellRateCards SellRateCard[]
  wallet        Wallet?
  agreements    Agreement[]
  quotations    Quotation[]
  telegramLink  TelegramLink?

  @@index([name])
  @@index([tenantId])
}

// ---------- Fleet ----------

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  MAINTENANCE
  INACTIVE
}

model Vehicle {
  id           String        @id @default(cuid())
  registration String        @unique
  type         String
  capacityKg   Float?
  status       VehicleStatus @default(AVAILABLE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  tenantId String?

  drivers Driver[]
  orders  Order[]

  @@index([tenantId])
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
}

model Driver {
  id        String       @id @default(cuid())
  userId    String       @unique
  user      User         @relation(fields: [userId], references: [id])
  phone     String
  licenseNo String
  status    DriverStatus @default(AVAILABLE)
  vehicleId String?
  vehicle   Vehicle?     @relation(fields: [vehicleId], references: [id])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  tenantId String?

  orders Order[]

  @@index([vehicleId])
  @@index([tenantId])
}

// ---------- Locations ----------

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  address   String
  city      String
  createdAt DateTime @default(now())

  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  tenantId String?

  originOrders      Order[] @relation("OriginWarehouse")
  destinationOrders Order[] @relation("DestinationWarehouse")

  @@index([tenantId])
}

// ---------- Orders / shipments ----------

enum OrderStatus {
  CREATED
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}

enum OrderFulfillmentType {
  SELF_FLEET
  COURIER_PARTNER
}

enum OrderAssignmentMethod {
  MANUAL
  AUTO
}

model Order {
  bookingKey String? @unique
  shipmentDetails Json?
  bookingState String?
  id           String   @id @default(cuid())
  trackingCode String   @unique
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])

  pickupAddress      String
  pickupContactName  String
  pickupContactPhone String
  pickupPincode      String?
  originWarehouseId  String?
  originWarehouse    Warehouse? @relation("OriginWarehouse", fields: [originWarehouseId], references: [id])

  deliveryAddress        String
  deliveryContactName    String
  deliveryContactPhone   String
  deliveryPincode        String?
  destinationWarehouseId String?
  destinationWarehouse   Warehouse? @relation("DestinationWarehouse", fields: [destinationWarehouseId], references: [id])

  weightKg           Float?
  packageDescription String?
  codAmount          Float?

  status OrderStatus @default(CREATED)

  driverId  String?
  driver    Driver?  @relation(fields: [driverId], references: [id])
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  fulfillmentType           OrderFulfillmentType  @default(SELF_FLEET)
  assignmentMethod          OrderAssignmentMethod @default(MANUAL)
  courierPartnerId          String?
  courierPartner            CourierPartner?       @relation(fields: [courierPartnerId], references: [id])
  courierBranchId           String?
  courierBranch             CourierBranch?        @relation(fields: [courierBranchId], references: [id])
  platformFeeAmount         Float?
  courierPayoutAmount       Float?
  providerRef               String?
  providerLabelUrl          String?
  chargedAmount             Float?
  // Which specific option within the assigned provider was picked at
  // dispatch time (e.g. one of Shiprocket's several bundled couriers) —
  // set by assignOrderToCourierAction, read by provider.createShipment
  // when the shipment is actually booked.
  selectedProviderCourierId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusEvents        OrderStatusEvent[]
  proofOfDelivery     ProofOfDelivery?
  invoiceLineItems    InvoiceLineItem[]
  settlementLineItems SettlementLineItem[]

  @@index([customerId])
  @@index([driverId])
  @@index([status])
  @@index([deliveryPincode])
  @@index([courierPartnerId])
  @@index([tenantId])
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model ProofOfDelivery {
  id           String   @id @default(cuid())
  orderId      String   @unique
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  signedByName String
  photoUrl     String?
  notes        String?
  createdAt    DateTime @default(now())
}

// ---------- Courier aggregator marketplace ----------
// Courier partners onboard onto the platform and fulfill orders alongside
// (not instead of) the self-fleet model above. Manual/WhatsApp coordination
// today; real per-courier API integration is a planned next phase.

enum CourierPartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum CourierIntegrationType {
  MANUAL
  API
}

enum CommissionType {
  PERCENT
  FLAT
}

enum CourierAgreementStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

model CourierPartner {
  assignedCustomers CustomerCourier[]
  id                String                 @id @default(cuid())
  name              String
  legalName         String?
  contactName       String
  contactPhone      String
  contactEmail      String?
  // Required to sync this partner's paid Settlements to AN-accounting as
  // purchase invoices (expenses) — see src/lib/accounting-sync.ts. A
  // partner with no GSTIN on file is skipped rather than blocking sync.
  gstin             String?
  status            CourierPartnerStatus   @default(PENDING)
  integrationType   CourierIntegrationType @default(MANUAL)
  commissionType    CommissionType         @default(PERCENT)
  commissionValue   Float
  // Routing precedence when multiple partners (including our own self-fleet,
  // which is registered as a partner row too) service a pincode — higher
  // goes first. Lets "check our own network, then fall back to a ranked
  // local partner" be an explicit admin setting rather than alphabetical.
  priority          Int                    @default(0)
  notes             String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  // Nullable: most partners are pure fulfillment options with no tenant
  // login/billing identity of their own. Set only when a partner is also
  // onboarded as a client/business we operate (see Tenant doc comment).
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  tenantId String? @unique

  branches    CourierBranch[]
  agreements  CourierAgreement[]
  apiConfig   CourierApiConfig?
  orders      Order[]
  rateCards   RateCard[]
  quotations  Quotation[]
  settlements Settlement[]

  @@index([status])
}

model CourierBranch {
  id               String         @id @default(cuid())
  courierPartnerId String
  courierPartner   CourierPartner @relation(fields: [courierPartnerId], references: [id])
  name             String
  address          String
  city             String
  contactPhone     String
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  serviceAreas ServiceArea[]
  orders       Order[]

  @@index([courierPartnerId])
}

model ServiceArea {
  id              String        @id @default(cuid())
  courierBranchId String
  courierBranch   CourierBranch @relation(fields: [courierBranchId], references: [id])
  pincode         String
  city            String?
  createdAt       DateTime      @default(now())

  @@index([pincode])
  @@index([courierBranchId])
}

model CourierAgreement {
  id               String                 @id @default(cuid())
  courierPartnerId String
  courierPartner   CourierPartner         @relation(fields: [courierPartnerId], references: [id])
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  commissionType   CommissionType
  commissionValue  Float
  documentUrl      String?
  status           CourierAgreementStatus @default(DRAFT)
  createdAt        DateTime               @default(now())

  @@index([courierPartnerId])
}

// ---------- Rate cards ----------
// A courier partner's priced offering: a named, versioned card of
// weight/zone-banded slabs. Only one card per partner is ACTIVE at a time —
// mirrors the CourierAgreement supersede-on-create pattern above.

model RateCard {
  id               String         @id @default(cuid())
  courierPartnerId String
  courierPartner   CourierPartner @relation(fields: [courierPartnerId], references: [id])
  name             String
  isActive         Boolean        @default(true)
  effectiveFrom    DateTime
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  slabs RateCardSlab[]

  @@index([courierPartnerId])
}

model RateCardSlab {
  id          String   @id @default(cuid())
  rateCardId  String
  rateCard    RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)
  zone        String
  minWeightKg Float
  maxWeightKg Float
  price       Float
  isActive    Boolean  @default(true)

  @@index([rateCardId])
}

// ---------- Sell pricing (what we charge, distinct from RateCard = what a
// courier charges us) ----------
// tenantId null = the default price list, used for ordinary/normal-user
// bookings (the public marketplace flow, see getMarketplaceTenantId in
// src/lib/actions/public-booking.ts). A row with tenantId set overrides
// this for one specific commercial-volume Tenant (TenantType.CLIENT) that
// negotiated its own rates — deliberately keyed off the existing
// Tenant/TenantType distinction rather than a new "customer tier" concept,
// since CLIENT already means exactly "a business whose volume we operate
// under negotiated terms" (see the TenantType doc comment above).
model SellRateCard {
  id               String    @id @default(cuid())
  tenantId         String?
  tenant           Tenant?   @relation(fields: [tenantId], references: [id])
  // Business/individual-specific price list, agreed via Agreement below.
  // Resolution order (see getSellPrice): a Customer-scoped ACTIVE card
  // wins over the tenant-wide default (customerId null) — most-specific
  // wins, same as a business's staff all sharing their Customer's card.
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id])
  name             String
  isActive         Boolean   @default(true)
  effectiveFrom    DateTime
  // Floor check, not enforced pricing: if set, a computed sell price that
  // would leave less than this % margin over a given courier's cost is
  // flagged (belowMarginFloor) wherever it's quoted, rather than silently
  // booked at a loss. Null = no floor check for this price list.
  minMarginPercent Float?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  slabs      SellRateCardSlab[]
  agreements Agreement[]

  @@index([tenantId])
  @@index([customerId])
}

model SellRateCardSlab {
  id             String       @id @default(cuid())
  sellRateCardId String
  sellRateCard   SellRateCard @relation(fields: [sellRateCardId], references: [id], onDelete: Cascade)
  zone           String
  minWeightKg    Float
  maxWeightKg    Float
  price          Float
  isActive       Boolean      @default(true)

  @@index([sellRateCardId])
}

model CourierApiConfig {
  id               String         @id @default(cuid())
  courierPartnerId String         @unique
  courierPartner   CourierPartner @relation(fields: [courierPartnerId], references: [id])
  provider         String
  baseUrl          String?
  // AES-256-GCM ciphertext (iv:authTag:ciphertext, base64), see src/lib/crypto.ts.
  // Encrypted on write in createOrUpdateApiConfigAction; requires ENCRYPTION_KEY.
  apiKeyEncrypted  String?
  webhookUrl       String?
  isActive         Boolean        @default(false)
}

// ---------- Wallet (AN Pay, via AN-accounting) ----------
// One wallet per Customer (business or individual). Debited when an order
// is actually handed to a courier (assignOrderToCourierAction), not at
// order creation — see lib/wallet.ts. Balance changes always go through
// WalletTransaction so the ledger, not just the running total, is the
// source of truth; `balance` is a cached sum for fast reads.

enum WalletTransactionType {
  CREDIT
  DEBIT
}

model Wallet {
  id         String   @id @default(cuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id])
  balance    Float    @default(0)
  currency   String   @default("INR")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id           String                @id @default(cuid())
  walletId     String
  wallet       Wallet                @relation(fields: [walletId], references: [id])
  type         WalletTransactionType
  amount       Float
  balanceAfter Float
  orderId      String?
  // ANyPay (AN-accounting) reference for this movement, when the entry was
  // pushed to/confirmed by the central wallet ledger rather than purely
  // local (e.g. a manual top-up recorded here before ANyPay confirms it).
  externalRef  String?
  note         String?
  createdAt    DateTime              @default(now())

  @@index([walletId])
  @@index([orderId])
}

// ---------- Agreements / e-sign ----------
// A Customer's agreed commercial terms (B2B for BUSINESS Customers, B2C for
// INDIVIDUAL) — this is the agreement a customer signs with us to be
// serviced through the platform (single courier or full aggregation,
// decided separately per their SellRateCard/routing setup), signed through
// Zoho Sign (see lib/agreements.ts). Once SIGNED, sellRateCardId is the
// price list that was actually agreed and should be activated for this
// Customer. renewalDate drives the reminder cron
// (api/cron/agreement-renewals) — left unset for agreements with no fixed
// term.

enum AgreementKind {
  B2B
  B2C
}

enum AgreementStatus {
  SENDING
  DRAFT
  SENT
  SIGNED
  VOID
}

model Agreement {
  title                 String?
  termsSnapshot         String?
  rateSnapshot          Json?
  legalReviewedAt       DateTime?
  id                    String          @id @default(cuid())
  customerId            String
  customer              Customer        @relation(fields: [customerId], references: [id])
  kind                  AgreementKind
  status                AgreementStatus @default(DRAFT)
  templateVersion       String
  documentUrl           String?
  sellRateCardId        String?
  sellRateCard          SellRateCard?   @relation(fields: [sellRateCardId], references: [id])
  // Envelope/session id from the central e-sign API, for status polling and
  // webhook correlation once that integration exists.
  externalEnvelopeId    String?
  signerName            String?
  signerEmail           String?
  sentAt                DateTime?
  signedAt              DateTime?
  // When this agreement's terms are up for renewal. Null means open-ended
  // (no reminder sent). renewalReminderSentAt guards against the daily
  // cron re-notifying every run once a reminder's gone out.
  renewalDate           DateTime?
  renewalReminderSentAt DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([customerId])
  @@index([externalEnvelopeId])
  @@index([renewalDate])
}

// ---------- Telegram ----------
// One link per Customer, covering both an individual's personal DM (chatId)
// and a business's group (groupChatId) — both populated the same way, via
// the /start deep-link flow in src/app/api/telegram/webhook/route.ts
// (same pattern as My-Biz-Flow's TelegramSettings).

model TelegramLink {
  id             String   @id @default(cuid())
  customerId     String   @unique
  customer       Customer @relation(fields: [customerId], references: [id])
  chatId         String?
  chatTitle      String?
  groupChatId    String?
  groupChatTitle String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([chatId])
  @@index([groupChatId])
}

// Internal ops notifications — distinct from TelegramLink (which is a
// per-Customer DM/group for THAT customer's own shipment updates). This is
// staff's own ops group(s): one Telegram group chat id per event type,
// configured from Settings -> Telegram notifications. A event with no
// row configured (or isActive false) is silently skipped wherever it's
// fired from (see notifyOpsTelegram in lib/telegram.ts).
enum TelegramNotificationEvent {
  PARTNER_APPLICATION
  ORDER_STATUS_CHANGE
  AGREEMENT_SENT
  AGREEMENT_SIGNED
  AGREEMENT_RENEWAL_DUE
}

model TelegramNotificationChannel {
  id          String                    @id @default(cuid())
  event       TelegramNotificationEvent @unique
  groupChatId String
  isActive    Boolean                   @default(true)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
}

// ---------- Billing ----------
// Two distinct money-flow directions: Invoice is us billing a CLIENT tenant
// for platform usage; Settlement is us reconciling payouts with a
// CourierPartner. A partner who is also a tenant can see their Settlements
// through their tenant portal view (Settlement.tenantId).

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

enum SettlementStatus {
  DRAFT
  FINALIZED
  PAID
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  tenantId      String
  tenant        Tenant        @relation("InvoiceForTenant", fields: [tenantId], references: [id])
  periodStart   DateTime
  periodEnd     DateTime
  status        InvoiceStatus @default(DRAFT)
  subtotal      Float
  taxAmount     Float         @default(0)
  totalAmount   Float
  issuedAt      DateTime?
  dueAt         DateTime?
  paidAt        DateTime?
  pdfUrl        String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lineItems InvoiceLineItem[]

  @@index([tenantId])
  @@index([status])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?  @relation(fields: [orderId], references: [id])
  description String
  quantity    Float   @default(1)
  unitPrice   Float
  amount      Float

  @@index([invoiceId])
  @@index([orderId])
}

model Settlement {
  id                 String           @id @default(cuid())
  settlementNumber   String           @unique
  courierPartnerId   String
  courierPartner     CourierPartner   @relation(fields: [courierPartnerId], references: [id])
  tenantId           String?
  tenant             Tenant?          @relation("SettlementForTenant", fields: [tenantId], references: [id])
  periodStart        DateTime
  periodEnd          DateTime
  status             SettlementStatus @default(DRAFT)
  grossPayoutAmount  Float
  commissionDeducted Float
  netAmount          Float
  paidAt             DateTime?
  createdAt          DateTime         @default(now())

  lineItems SettlementLineItem[]

  @@index([courierPartnerId])
  @@index([tenantId])
}

model SettlementLineItem {
  id               String     @id @default(cuid())
  settlementId     String
  settlement       Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  orderId          String
  order            Order      @relation(fields: [orderId], references: [id])
  payoutAmount     Float
  commissionAmount Float

  @@index([settlementId])
  @@index([orderId])
}

// Public applications do not create login credentials. Existing customers are unaffected.
enum ApplicationStatus {
  NEW
  CONTACTED
  QUOTATION
  NEGOTIATING
  AGREEMENT
  ACTIVE
  REJECTED
}

model PartnerApplication {
  id             String            @id @default(cuid())
  email          String            @unique
  name           String
  phone          String
  company        String?
  accountType    String
  address        String
  pincode        String
  gstin          String?
  monthlyVolume  Int
  requirements   String?
  consentAt      DateTime
  privacyVersion String            @default("2026-10-18")
  status         ApplicationStatus @default(NEW)
  notes          String            @default("")
  customerId     String?           @unique
  customer       Customer?         @relation(fields: [customerId], references: [id])
  quotations     Quotation[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, createdAt])
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  REVISION_REQUESTED
  EXPIRED
}

model Quotation {
  id              String            @id @default(cuid())
  quoteNumber     String            @unique
  applicationId   String?
  application     PartnerApplication? @relation(fields: [applicationId], references: [id])
  customerId      String?
  customer        Customer?         @relation(fields: [customerId], references: [id])
  courierPartnerId String?
  courierPartner  CourierPartner?   @relation(fields: [courierPartnerId], references: [id])
  status          QuotationStatus   @default(DRAFT)
  title           String
  validUntil      DateTime?
  termsSnapshot   String
  rateSnapshot    Json
  sentAt          DateTime?
  acceptedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  @@index([status, createdAt])
}

model CustomerCourier {
  id               String         @id @default(cuid())
  customerId       String
  customer         Customer       @relation(fields: [customerId], references: [id])
  courierPartnerId String
  courierPartner   CourierPartner @relation(fields: [courierPartnerId], references: [id])

  @@unique([customerId, courierPartnerId])
}

model AgreementTemplate {
  id        String   @id @default(cuid())
  name      String
  category  String
  version   String
  terms     String
  createdAt DateTime @default(now())

  @@unique([name, version])
}
